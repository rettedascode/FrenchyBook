{% extends 'base.html.twig' %}

{% block title %}{{ 'reset.new.title'|trans }}{% endblock %}

{% block body %}
<div class="auth">
    <div class="auth-hero">
        <div class="logo-mark">{{ icon('lock') }}</div>
        <h1>{{ 'reset.new.title'|trans }}</h1>
        <p>{{ 'reset.new.intro'|trans({name: user.name}) }}</p>
    </div>

    <div class="card">
        {{ form_start(form, {attr: {class: 'form', novalidate: 'novalidate'}}) }}
            {{ form_errors(form) }}
            {# Für Passwort-Manager: zu welchem Konto das neue Passwort gehört #}
            <input type="text" name="username" value="{{ user.name }}" autocomplete="username" hidden readonly>
            {{ form_row(form.plainPassword) }}
            <button type="submit" class="btn btn-primary btn-block btn-lg">{{ icon('check') }} {{ 'reset.new.submit'|trans }}</button>
        {{ form_end(form) }}
    </div>
</div>
{% endblock %}
