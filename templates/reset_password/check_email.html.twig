{% extends 'base.html.twig' %}

{% block title %}{{ 'reset.check.title'|trans }}{% endblock %}

{% block body %}
<div class="auth">
    <div class="auth-hero">
        <div class="logo-mark">{{ icon('send') }}</div>
        <h1>{{ 'reset.check.title'|trans }}</h1>
    </div>

    <div class="card stack">
        <p>{{ 'reset.check.text'|trans({minutes: lifetimeMinutes}) }}</p>
        <div class="notice">{{ icon('info') }}<p>{{ 'reset.check.spam_hint'|trans }}</p></div>
        <a class="btn btn-primary btn-block" href="{{ path('app_login') }}">{{ 'reset.back_to_login'|trans }}</a>
    </div>

    <p class="auth-switch">{{ 'reset.check.no_mail'|trans }} <a href="{{ path('app_forgot_password') }}">{{ 'reset.check.try_again'|trans }}</a></p>
</div>
{% endblock %}
