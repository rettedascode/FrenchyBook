{% extends 'base.html.twig' %}

{% block title %}{{ 'error.404.title'|trans }}{% endblock %}

{% block body %}
<div class="error-page">
    <div class="error-code">404</div>
    <h1>{{ 'error.404.title'|trans }}</h1>
    <p class="muted">{{ 'error.404.text'|trans }}</p>
    <a class="btn btn-primary" href="{{ path('app_book_index') }}">{{ 'error.to_books'|trans }}</a>
</div>
{% endblock %}
