{% extends 'email/_layout.html.twig' %}
{% block content %}
    <p style="margin:0 0 16px;">{{ 'email.reset.text'|trans }}</p>
    {{ include('email/_button.html.twig', {url: resetUrl, label: 'email.reset.button'|trans}) }}
    <p style="margin:16px 0 0;font-size:14px;color:#5f636b;">{{ 'email.reset.validity'|trans({minutes: lifetimeMinutes}) }}</p>
    <p style="margin:12px 0 0;font-size:14px;color:#5f636b;">{{ 'email.reset.ignore'|trans }}</p>
    <p style="margin:16px 0 0;font-size:12px;color:#767a82;">{{ 'email.reset.link_fallback'|trans }}<br><a href="{{ resetUrl }}" style="color:#2c55b8;word-break:break-all;">{{ resetUrl }}</a></p>
{% endblock %}
