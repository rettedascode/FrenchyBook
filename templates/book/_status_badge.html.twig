{#
    Status eines Buchs:
    grün „Abholung bei Eigentümer“, orange „Aktuell ausgeliehen“ (bzw. „Bei dir“),
    rot „Zur Rückgabe fällig“ (Termin in wenigen Tagen oder überschritten).
    Parameter: loan (aktive Ausleihe oder null)
#}
{%- if loan is null -%}
    <span class="badge badge-available"><span>{{ 'status.pickup'|trans }}</span></span>
{%- else -%}
    {%- set is_me = app.user and loan.borrower.id == app.user.id -%}
    {%- if loan.returnDue -%}
        <span class="badge badge-overdue" title="{{ 'status.due_hint'|trans({date: loan.dueAt|ldate}) }}"><span>{{ is_me ? 'status.due_me'|trans : 'status.due'|trans }}</span></span>
    {%- else -%}
        <span class="badge badge-lent"><span>{{ is_me ? 'status.lent_me'|trans : 'status.on_loan'|trans }}</span></span>
    {%- endif -%}
{%- endif -%}
