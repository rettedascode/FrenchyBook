<div class="book-tile" role="listitem">
    <a href="{{ path('app_book_show', {id: book.id}) }}">
        {{ include('book/_cover.html.twig', {book: book, decorative: true, eager: eager ?? false}) }}
        <div class="book-tile-title">{{ book.title }}</div>
        {% if book.authorNames %}<div class="book-tile-author">{{ book.authorNames }}</div>{% endif %}
        <div class="book-tile-owner">{{ icon('user') }}<span>{{ book.isOwnedBy(app.user) ? 'books.tile.owner_me'|trans : 'books.tile.owner'|trans({name: book.owner.name}) }}</span></div>
        {% set tile_loan = activeLoans[book.id] ?? null %}
        {% set tile_holder = tile_loan and tile_loan.handedOver ? tile_loan.borrower : book.owner %}
        {# Auf der Kachel nur der Stadtteil (kurz), sonst der Bezirk #}
        {% set tile_district = tile_holder.quarter ? tile_holder.quarter.label : (tile_holder.district ? tile_holder.district|trans : null) %}
        {% if book.rating or tile_district %}
            <div class="book-tile-meta">
                {% if book.rating %}{{ include('book/_stars.html.twig', {rating: book.rating}) }}{% endif %}
                {% if tile_district %}<span class="book-tile-district">{{ icon('map-pin') }}{{ tile_district }}</span>{% endif %}
            </div>
        {% endif %}
        {{ include('book/_status_badge.html.twig', {loan: tile_loan}) }}
    </a>
</div>
